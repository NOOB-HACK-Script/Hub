            for _, v in pairs(getgc(true)) do
                if type(v) == "table" then
                    if rawget(v, "camRecoil") then 
                        v.camRecoil.camRecoilUp = {0, 0} 
                        v.camRecoil.camRecoilTilt = {0, 0} 
                        v.camRecoil.camRecoilLeft = {0, 0} 
                        v.camRecoil.camRecoilRight = {0, 0} 
                    end
                    if rawget(v, "MinRecoilPower") then 
                        v.MinRecoilPower = 0 
                        v.MaxRecoilPower = 0 
                        v.RecoilPunch = 0 
                        v.VisualRecoil = 0 
                        v.MinSpread = 0 
                        v.MaxSpread = 0 
                    end
                    if rawget(v, "FireModes") then 
                        v.FireModes.Auto = true 
                        v.BulletPenetration = 500 
                    end
                end
            end
        end)
        recoilBtn.Text = "Done!"
        task.wait(1.5)
        recoilBtn.Text = "Fix Anti-Recoil (One Click)"
    end)
end)

espBtn.MouseButton1Click:Connect(function()
